rules_version = '2';

// Craft rules based on data models and app architecture
// Single-Tenant Owner-Only Storage Rules for Cafe Eldeeb
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions for authentication and owner verification
    function isAuthenticated() {
      return request.auth != null;
    }

    function isNonAnonymous() {
      return request.auth.token.firebase.sign_in_provider != 'anonymous' && request.auth.token.email != null;
    }

    function isVerifiedOwner() {
      return isAuthenticated()
        && isNonAnonymous()
        && request.auth.token.email.lower() == 'nader.eldeeb.2015@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isValidBackupUpload() {
      return request.resource.contentType.matches('application/json.*')
        && request.resource.size <= 50 * 1024 * 1024; // 50MB max limit
    }

    // Secured Cloud Backup path for Cafe Eldeeb
    match /cafes/main_cafe_eldeeb/backups/{fileName} {
      allow read: if isVerifiedOwner();
      allow delete: if isVerifiedOwner();
      allow create, update: if isVerifiedOwner() && isValidBackupUpload();
    }

    // Default deny rule for all other storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
