+      "title": "Cafe Sync Document",
+      "description": "Synced state item for Cafe Eldeeb POS",
+      "type": "object",
+      "properties": {
+        "id": { "type": "string" },
+        "updated_at": { "type": "string" },
+        "cafe_id": { "type": "string" }
+      },
+      "required": ["id"]
+    }
+  },
+  "firestore": {
+    "/cafes/{cafeId}/sync_store/{docId}": {
+      "schema": "CafeSyncDoc",
+      "description": "Real-time sync store for cafe entity collections"
+    }
+  }
+}
diff --git a/firestore.rules b/firestore.rules
new file mode 100644
index 0000000..d99dfa3
--- /dev/null
+++ b/firestore.rules
@@ -0,0 +1,14 @@
+rules_version = '2';
+service cloud.firestore {
+  match /databases/{database}/documents {
+    match /cafes/{cafeId}/sync_store/{document=**} {
+      allow read, write: if true;
+    }
+    match /test/{document=**} {
+      allow read, write: if true;
+    }
+    match /{document=**} {
+      allow read, write: if false;
+    }
+  }
+}
